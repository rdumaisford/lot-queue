rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Original Get Ready sheet PDFs, uploaded from the Get Ready modal.
    // Storage rules can't check the Realtime Database "approved" user list
    // the way database.rules.json does, so this only distinguishes "a real
    // signed-in staff account" (anonymous is the TV kiosk sign-in) from
    // everyone else - pair this with the app's own login gate.
    match /getready-pdfs/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
