rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Original Get Ready sheet PDFs, uploaded from the Get Ready modal.
    // Storage rules can't check the Realtime Database "approved" user list
    // the way database.rules.json does, so this only distinguishes "a real
    // signed-in staff account" (anonymous is the TV kiosk sign-in) from
    // everyone else - pair this with the app's own login gate.
    match /getready-pdfs/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if false;
    }

    // Gas/charge completion photos (receipt, or the vehicle plugged in) -
    // required before marking gas filled/charging complete on a Get Ready
    // deal (see grHandleFuelPhotoSelected). Same "real signed-in staff
    // account" bar as the PDFs above - the actual flow only ever offers
    // this to whoever can touch the gas/charge banner in the first place.
    match /getready-fuel-photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // Announcement PDFs - the Add/Edit Announcement modal only exposes the
    // attach button to management, but Storage rules can't check that role
    // (it lives in the Realtime Database, not an auth custom claim), so
    // this is the same "real signed-in staff account" bar as getready-pdfs
    // above, not a true management-only guarantee.
    match /announcement-pdfs/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if false;
    }

    // Reference files (invoices, etc) attached to a Get Ready deal beyond
    // its one required deal sheet PDF above - any file type, since these
    // are never read back by pdf-lib, just linked for staff to open.
    match /getready-attachments/{dealId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.size < 20 * 1024 * 1024;
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
